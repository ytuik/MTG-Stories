# Arquivos compilados completos são grandes demais para o GitHub (300+ MB)
COMPLETE_STORIES.pdf
COMPLETE_STORIES_WITHOUT_IMAGES.pdf
# PDFs de set inteiro gerados a partir dos wrappers na raiz de stories/
stories/*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Typst
target/

# Saída e cache da conversão EPUB
epubs/
*.tmp.typ

# Instalação local do EpubCheck
tools/

# Cache local do compressor de imagens
.image-compress-cache.json

# Cache e relatório da compilação de PDF
.pdf-cache.json
.pdf-cache.json.lock
pdf-report.json
status.json

# PDFs são saídas de build (gere com: python typ2pdf.py --missing)
stories/**/*.pdf
planeswalkers_guides/**/*.pdf
card_lore/**/*.pdf
build/
